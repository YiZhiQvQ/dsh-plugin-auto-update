{
  "name": "dsh-plugin-update",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Checks npm and Git sources for newer versions of this profile's DSH plugins and updates them in one click.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YiZhiQvQ/dsh-plugin-update.git"
  },
  "homepage": "https://github.com/YiZhiQvQ/dsh-plugin-update#readme",
  "bugs": {
    "url": "https://github.com/YiZhiQvQ/dsh-plugin-update/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "plugin",
    "update",
    "npm"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
